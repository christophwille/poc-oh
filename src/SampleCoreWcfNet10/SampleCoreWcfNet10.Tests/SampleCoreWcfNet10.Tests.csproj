<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<OutputType>Exe</OutputType>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" Version="9.6.0" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
		<PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
		<!-- transitive of System.ServiceModel.Http; pinned to a patched version (NU1903) -->
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
		<PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SampleCoreWcfNet10\SampleCoreWcfNet10.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
